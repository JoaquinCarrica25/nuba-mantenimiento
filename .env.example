# ============================================================
# NUBA MANTENIMIENTO — Variables de entorno
# ============================================================
# 1. Copia este archivo como ".env.local" (nunca subas .env.local a Git)
# 2. Rellena con los valores de tu proyecto en https://supabase.com
#    Settings → API → Project URL y anon public key
# 3. En Vercel: Settings → Environment Variables → añade las mismas

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui
